<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif"></mj-all>
      <mj-text align="left" padding="0"></mj-text>
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#ffffff" width="600px">
    <mj-section background-color="#ffffff" padding="24px 20px 0">
      <mj-column>
        <mj-text font-size="17px" line-height="24px" font-weight="600" color="#1a1a1a">{{ heading }}</mj-text>
      </mj-column>
    </mj-section>
    <mj-raw>{% if movie %}</mj-raw>
    <mj-section background-color="#ffffff" padding="18px 20px 0">
      <mj-group>
        <mj-raw>{% if movie.poster_link %}</mj-raw>
        <mj-column width="112px" vertical-align="top">
          <mj-image width="100px" padding="0" border-radius="6px" align="left" href="{{ cta_link }}" src="{{ movie.poster_link }}" alt=""></mj-image>
        </mj-column>
        <mj-raw>{% endif %}</mj-raw>
        <mj-column vertical-align="top">
          <mj-text font-size="16px" line-height="22px" font-weight="600" padding="0 0 0 14px"><a href="{{ cta_link }}" style="color:#0b6e64;text-decoration:none;">{{ movie.title }}</a></mj-text>
          <mj-text font-size="14px" line-height="20px" color="#5a5a5a" padding="4px 0 0 14px">{{ movie.cinema_name }} &middot; {{ movie.datetime_label }}</mj-text>
          <mj-text font-size="13px" line-height="20px" padding="6px 0 0 14px"><a href="{{ cta_link }}" style="color:#0b6e64;text-decoration:underline;">{{ cta_label }}</a></mj-text>
        </mj-column>
      </mj-group>
    </mj-section>
    <mj-raw>{% else %}</mj-raw>
    <mj-section background-color="#ffffff" padding="14px 20px 0">
      <mj-column>
        <mj-text font-size="14px" line-height="20px"><a href="{{ cta_link }}" style="color:#0b6e64;text-decoration:underline;">{{ cta_label }}</a></mj-text>
      </mj-column>
    </mj-section>
    <mj-raw>{% endif %}</mj-raw>
    <mj-section background-color="#ffffff" padding="24px 20px 24px">
      <mj-column>
        <mj-text font-size="12px" line-height="18px" color="#8a8a8a"><a href="{{ settings_link }}" style="color:#8a8a8a;text-decoration:underline;">Manage notification preferences</a>.</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
