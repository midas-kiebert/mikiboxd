<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif"></mj-all>
      <mj-text align="left" padding="0"></mj-text>
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#ffffff" width="600px">
    <mj-section background-color="#ffffff" padding="24px 20px 0">
      <mj-column>
        <mj-text font-size="15px" line-height="22px" color="#1a1a1a">{{ intro }}</mj-text>
      </mj-column>
    </mj-section>
    <mj-raw>{% for movie in movies %}</mj-raw>
    <mj-section background-color="#ffffff" padding="18px 20px 0">
      <mj-group>
        <mj-raw>{% if movie.poster_link %}</mj-raw>
        <mj-column width="72px" vertical-align="top">
          <mj-image width="60px" height="90px" padding="0" border-radius="4px" align="left" href="{{ movie.mikino_link }}" src="{{ movie.poster_link }}" alt=""></mj-image>
        </mj-column>
        <mj-raw>{% endif %}</mj-raw>
        <mj-column vertical-align="top">
          <mj-text font-size="16px" line-height="22px" font-weight="600" padding="0 0 0 12px"><a href="{{ movie.mikino_link }}" style="color:#0b6e64;text-decoration:none;">{{ movie.title }}</a></mj-text>
          <mj-text font-size="14px" line-height="20px" color="#5a5a5a" padding="3px 0 0 12px">{{ movie.cinema_name }} &middot; {{ movie.datetime_label }}</mj-text>
          <mj-text font-size="13px" line-height="20px" padding="5px 0 0 12px"><a href="{{ movie.mikino_link }}" style="color:#0b6e64;text-decoration:underline;">View on {{ brand_name }}</a>{% if movie.letterboxd_link %} <span style="color:#b0b0b0;">&middot;</span> <a href="{{ movie.letterboxd_link }}" style="color:#0b6e64;text-decoration:underline;">Letterboxd</a>{% endif %}</mj-text>
        </mj-column>
      </mj-group>
    </mj-section>
    <mj-raw>{% endfor %}</mj-raw>
    <mj-section background-color="#ffffff" padding="28px 20px 0">
      <mj-column>
        <mj-raw>{% for source in sources %}</mj-raw>
        <mj-text font-size="12px" line-height="18px" color="#8a8a8a" padding-top="{% if loop.first %}0{% else %}6px{% endif %}">{{ source.frequency_label }} digest, following {% if source.url %}<a href="{{ source.url }}" style="color:#8a8a8a;text-decoration:underline;">{{ source.label }}</a>{% else %}{{ source.label }}{% endif %}. {{ source.frequency_explainer }}</mj-text>
        <mj-raw>{% endfor %}</mj-raw>
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" padding="10px 20px 24px">
      <mj-column>
        <mj-text font-size="12px" line-height="18px" color="#8a8a8a"><a href="{{ unsubscribe_link }}" style="color:#8a8a8a;text-decoration:underline;">Stop these emails</a>.</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
