<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif"></mj-all>
      <mj-text align="left" padding="0" color="#12211c"></mj-text>
    </mj-attributes>
  </mj-head>
  <!-- The app's own palette (shared/theme/colors.ts, light): tint #0b8345,
       text #12211c, secondary #5a7268, background #f4f8f6. Same font, width and
       left-aligned layout as the event emails (notification.mjml). -->
  <mj-body background-color="#f4f8f6" width="600px">
    <mj-section padding="24px 20px 0">
      <mj-column>
        <mj-text font-size="15px" font-weight="700" color="#0b8345">{{ project_name }}</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" border-radius="14px" padding="28px 24px">
      <mj-column>
        <mj-text font-size="20px" line-height="28px" font-weight="700">Reset your password</mj-text>
        <mj-text font-size="15px" line-height="22px" color="#5a7268" padding="10px 0 0">Someone (hopefully you) asked to reset the password for {{ username }}. Choose a new one with the button below.</mj-text>
        <mj-button align="left" href="{{ link }}" background-color="#0b8345" color="#ffffff" font-size="15px" font-weight="700" border-radius="10px" inner-padding="12px 22px" padding="22px 0 0">Choose a new password</mj-button>
        <mj-text font-size="13px" line-height="20px" color="#5a7268" padding="22px 0 0">The link works for {{ valid_hours }} hours. If the button does not work, paste this into your browser:</mj-text>
        <mj-text font-size="13px" line-height="20px" padding="4px 0 0"><a href="{{ link }}" style="color:#0b8345;word-break:break-all;">{{ link }}</a></mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="16px 20px 28px">
      <mj-column>
        <mj-text font-size="12px" line-height="18px" color="#8a9a93">Didn't ask for this? Then you can ignore this email: your password stays as it is.</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
