@@ -432,8 +432,21 @@ function BottomSheetModalComponent<T = never>(
       currentIndexRef.current = _index;
       nextIndexRef.current = null;

-      statusRef.current =
-        _index === -1 ? MODAL_STATUS.MINIMIZED : MODAL_STATUS.PRESENTED;
+      // Patched (mikino): only a sheet that was being minimized is MINIMIZED
+      // when it reaches -1. Upstream marked every closed sheet MINIMIZED, and
+      // the provider "restores" (re-opens) a MINIMIZED sheet whenever the sheet
+      // above it in its queue unmounts — so a sheet the user had simply closed
+      // popped back open on its own (e.g. the notification centre on logout).
+      // A dismissal in progress keeps its own status for onClose to finish.
+      if (_index === -1) {
+        if (statusRef.current === MODAL_STATUS.MINIMIZING) {
+          statusRef.current = MODAL_STATUS.MINIMIZED;
+        } else if (statusRef.current !== MODAL_STATUS.DISMISSING) {
+          statusRef.current = MODAL_STATUS.CLOSED;
+        }
+      } else {
+        statusRef.current = MODAL_STATUS.PRESENTED;
+      }

